{
  "name": "nosto/module-nosto-msi",
  "description": "Compatibility plugin between Nosto and Magento multi-source inventory",
  "type": "magento2-module",
  "version": "4.0.0",
  "require-dev": {
    "phing/phing": "^3.0",
    "magento-ecg/coding-standard": "^4.5",
    "magento/module-store": "101.1.8",
    "magento/zendframework1": "1.14.3",
    "staabm/annotate-pull-request-from-checkstyle": "^1.1",
    "magento/magento-coding-standard": "^38",
    "phan/phan": "^6.0",
    "squizlabs/php_codesniffer": "^3.13",
    "phpmd/phpmd": "^2.15",
    "drenso/phan-extensions": "^3.5"
  },
  "license": [
    "OSL-3.0"
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "nosto/module-nostotagging": "^9.0",
    "magento/module-inventory": "^1.0.0",
    "magento/module-inventory-sales-api": "^1.0.0",
    "php": ">=8.2"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com/",
      "exclude": ["nosto/*"]
    }
  ],
  "autoload": {
    "psr-4": {
      "Nosto\\Msi\\": ""
    },
    "files": [
      "registration.php"
    ]
  },
  "archive": {
    "exclude": [
      "Jenkinsfile",
      "Dockerfile",
      ".DS_STORE",
      ".idea",
      ".phan",
      ".docker",
      "ruleset.xml",
      "ruleset-phpcompat.xml",
      "phan.*",
      ".gitignore",
      ".gitea",
      "build.xml",
      ".github",
      "supervisord.conf",
      "entrypoint.sh",
      "/magento"
    ]
  },
  "config": {
    "process-timeout": 3600,
    "platform": {
        "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "magento/inventory-composer-installer": false,
      "magento/composer-dependency-version-audit-plugin": true
    }
  },
  "scripts": {
    "di:compile": "./compile.sh",
    "ci:inspect": "./inspect.sh"
  }
}
